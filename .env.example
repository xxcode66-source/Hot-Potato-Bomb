# Copy to .env (never commit real secrets). Keys belong here, not in the repo.

# NEAR network: testnet | mainnet | local
NEAR_NETWORK=testnet

# Contract account the frontend talks to (fill after deploy)
CONTRACT_ID=potato.testnet

# Public RPC endpoint (verify current value at docs.near.org)
NEAR_RPC_URL=https://rpc.testnet.near.org

# Wallet connect helper clientId (optional; only needed for live mode)
NEAR_WALLET_APP_KEY=

# Demo mode: when true the UI runs the local deterministic simulator (no wallet needed)
VITE_DEMO_MODE=true
